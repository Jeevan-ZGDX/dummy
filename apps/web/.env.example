# ─── Firebase web config (public, safe to expose) ───────────────────
# From Firebase console → Project settings → Your apps → SDK setup.
# These ship to the browser by design; Firestore security rules and Firebase
# Auth control access, not the secrecy of these values.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ─── Firebase Admin (server-only, keep secret) ──────────────────────
# Service account JSON as a single-line string. Used by every server route,
# the migration script and the cron job. Locally you can instead drop the file
# at apps/web/service-account.json (gitignored) and leave this unset.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# ─── App API base URL (public) ──────────────────────────────────────
# Local:   http://localhost:3000/api
# Prod:    https://comp-dash.onrender.com/api
NEXT_PUBLIC_API_URL=https://comp-dash.onrender.com/api

# ─── Public app origin (public) ─────────────────────────────────────
# Public origin of the app. No trailing slash.
# Local:   http://localhost:3000
# Prod:    https://comp-dash.onrender.com
NEXT_PUBLIC_APP_URL=https://comp-dash.onrender.com

# ─── Google OAuth (server-only) ─────────────────────────────────────
# These are for the GMAIL VERIFICATION flow only. Google *sign-in* no longer
# uses them: Firebase Auth runs that handshake through its own
# <project>.firebaseapp.com/__/auth/handler, configured in the Firebase console
# under Authentication → Sign-in method → Google.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Gmail verification redirect URI (must also be authorized in Google Cloud).
# Local:   http://localhost:3000/api/auth/gmail/callback
# Prod:    https://comp-dash.onrender.com/api/auth/gmail/callback
GOOGLE_REDIRECT_URI=https://comp-dash.onrender.com/api/auth/gmail/callback

# ─── Real-time webhook (server-only) ────────────────────────────────
# Shared secret for POSTs to /api/real-time/registration. Pick a long
# random value; if unset the endpoint returns 503.
REAL_TIME_API_SECRET="change-me-to-a-long-random-string"

