{
  "name": "comp-dash",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "expo start --dev-client",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "build:web": "next build apps/web",
    "seed:auth": "node scripts/seed-auth.mjs",
    "seed:advisors": "node scripts/seed-advisor-auth.mjs",
    "lint": "eslint . --ext .tsx,.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "node scripts/seed-demo-registrations.mjs",
    "seed:demo-advisor": "node scripts/setup-demo-advisor.mjs",
    "seed:demo-verifications": "node scripts/seed-demo-verifications.mjs",
    "migrate:firestore": "node --env-file=.env scripts/migrate-supabase-to-firestore.mjs",
    "seed:firebase": "node --env-file=.env scripts/seed-firebase-auth.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "bullmq": "^6.2.0",
    "firebase": "^12.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^6.2.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
